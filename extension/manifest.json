{
  "manifest_version": 3,
  "name": "看山·阅读伙伴",
  "version": "0.9.0",
  "description": "知乎划线、金句与批注，连接看山桌宠，把阅读留成自己的笔记。",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:47840/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "连接看山",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhihu.com/*",
        "https://zhuanlan.zhihu.com/*"
      ],
      "js": [
        "reading.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1:47840/*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_idle"
    }
  ]
}